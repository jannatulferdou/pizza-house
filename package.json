{
  "name": "foodproduct",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev --workspace=@pizza-house/backend\" \"npm run dev --workspace=@pizza-house/frontend\"",
    "dev:api": "npm run dev --workspace=@pizza-house/backend",
    "dev:web": "npm run dev --workspace=@pizza-house/frontend",
    "typecheck": "npm run build --workspace=@pizza-house/shared && npm run typecheck --workspaces",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=@pizza-house/frontend",
    "build:backend": "npm run build --workspace=@pizza-house/backend",
    "test": "npm run test --workspace=@pizza-house/backend && node --test frontend/scripts/*.test.mjs",
    "test:deployment": "npm run build:backend && node --test scripts/deployment.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"{frontend,backend,shared}/src/**/*.{ts,tsx}\" frontend/vite.config.ts eslint.config.js package.json README.md",
    "preview": "npm run preview --workspace=@pizza-house/frontend",
    "start": "npm start --workspace=@pizza-house/backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
