PORT=3001
# Production defaults to 0.0.0.0; development defaults to 127.0.0.1.
# HOST=0.0.0.0
# Set to the known reverse-proxy hop count for your hosting network.
TRUST_PROXY=0
# Public FRONTEND origin (Vercel/custom domain), without a trailing path.
APP_URL=http://localhost:5173
# Relative to backend/. In production use an absolute persistent disk path.
DATABASE_PATH=../data/pizza-house.sqlite
NODE_ENV=development
# Set before the first server start to create an administrator. No default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public shop contact details; omitted contact links stay hidden.
SHOP_EMAIL=
SHOP_PHONE=
SHOP_WHATSAPP=
# Branches are published only when configured. Times are Bangladesh time (UTC+6).
# Use unique IDs, weekdays 0=Sunday to 6=Saturday, same-day opens < closes.
# Example only: replace the name/address with your actual branch before enabling pickup.
# SHOP_BRANCHES=[{"id":"main","name":"Main kitchen","address":"Your full street address, Dhaka","opens":"10:00","closes":"22:00","days":[0,1,2,3,4,5,6],"timeZone":"Asia/Dhaka","pickup":true}]
SHOP_BRANCHES=
# HTTPS notification adapters accepting the JSON contract documented in README.
# Configure your adapter to send email/SMS through your chosen provider.
EMAIL_WEBHOOK_URL=
SMS_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Hosted checkout: set both merchant credentials and a publicly reachable APP_URL.
# Keep sandbox mode until merchant onboarding and end-to-end verification are complete.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
