{
  "name": "@pizza-house/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run build --workspace=@pizza-house/shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build --workspace=@pizza-house/shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/production.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace=@pizza-house/shared",
    "test": "tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "@pizza-house/shared": "0.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
