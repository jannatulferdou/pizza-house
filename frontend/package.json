{
  "name": "@pizza-house/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run build --workspace=@pizza-house/shared",
    "dev": "vite",
    "prebuild": "npm run build --workspace=@pizza-house/shared",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pizza-house/shared": "0.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
